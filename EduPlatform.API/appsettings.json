{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "EduPlatform",
    "Audience": "EduPlatformUsers",
    "ExpiryHours": "24",
    "RefreshTokenDays": "7"
  },

  "Seeding": {
    "AdminEmail": "admin@eduplatform.com",
    "AdminPassword": "",
    "AdminFullName": "Platform Admin"
  },

  "Cors": {
    "AllowedOrigins": [
      "https://yourfrontend.com"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },

      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],

    "Enrich": [
      "FromLogContext"
    ],

    "Properties": {
      "Application": "EduPlatform.API"
    }
  },

  "AllowedHosts": "*"
}