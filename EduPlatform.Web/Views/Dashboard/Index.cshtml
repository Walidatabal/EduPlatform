@model EduPlatform.Web.ViewModels.Dashboard.DashboardVM
@using EduPlatform.Domain.Constants

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = $"{Model.UserRole} Dashboard";

    // Read selected language from query string first.
    var currentLang = Context.Request.Query["lang"].ToString();

    // If query string is empty, read language from cookie.
    if (string.IsNullOrWhiteSpace(currentLang))
    {
        currentLang = Context.Request.Cookies["lang"] ?? "en";
    }

    // Arabic flag used to switch text between Arabic and English.
    var isArabic = currentLang == "ar";

    // Role flags used to render role-specific dashboard content.
    var isAdmin = Model.UserRole == AppRoles.Admin ||
                  Model.UserRole == AppRoles.ContentManager;

    var isTeacher = Model.UserRole == AppRoles.Teacher;

    var isStudent = Model.UserRole == AppRoles.Student;
}

<!-- Role-aware profile banner -->
<div class="profile-banner">
    <div class="profile-avatar-wrap">
        <div class="avatar lg">@(string.IsNullOrWhiteSpace(Model.UserFullName) ? "U" : Model.UserFullName[..1].ToUpper())</div>
    </div>
    <div>
        <div class="profile-name">@Model.UserFullName</div>
        <div class="profile-role">
            @Model.UserEmail · <span class="badge purple">@Model.UserRole</span>
        </div>

        <div class="profile-stats">
            @if (isAdmin)
            {
                <div class="profile-stat-item"><strong>@Model.UsersCount</strong><span>Users</span></div>
                <div class="profile-stat-item"><strong>@Model.CoursesCount</strong><span>Courses</span></div>
                <div class="profile-stat-item"><strong>@Model.OrdersCount</strong><span>Orders</span></div>
                <div class="profile-stat-item"><strong>@Model.TotalRevenue.ToString("0.000") KD</strong><span>Revenue</span></div>
            }
            else if (isTeacher)
            {
                <div class="profile-stat-item"><strong>@Model.MyCoursesCount</strong><span>My Courses</span></div>
                <div class="profile-stat-item"><strong>@Model.EnrollmentsCount</strong><span>Enrollments</span></div>
                <div class="profile-stat-item"><strong>@Model.MyRevenue.ToString("0.000") KD</strong><span>Revenue</span></div>
                <div class="profile-stat-item"><strong>@Model.LiveSessionsCount</strong><span>Sessions</span></div>
            }
            else
            {
                <div class="profile-stat-item"><strong>@Model.MyEnrollmentsCount</strong><span>Enrolled</span></div>
                <div class="profile-stat-item"><strong>@Model.MyWishlistCount</strong><span>Wishlist</span></div>
                <div class="profile-stat-item"><strong>@Model.MyCartCount</strong><span>Cart</span></div>
                <div class="profile-stat-item"><strong>@Model.MyCertificatesCount</strong><span>Certificates</span></div>
            }
        </div>
    </div>
</div>

@if (isAdmin)
{
    <!-- Admin/ContentManager dashboard -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Users</span><span class="stat-icon purple">👥</span></div>
            <div class="stat-value">@Model.UsersCount</div>
            <div class="stat-trend">@Model.StudentsCount students · @Model.TeachersCount teachers</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Courses</span><span class="stat-icon blue">📚</span></div>
            <div class="stat-value">@Model.CoursesCount</div>
            <div class="stat-trend">@Model.PublishedCoursesCount published · @Model.PendingCoursesCount pending</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Revenue</span><span class="stat-icon green">💳</span></div>
            <div class="stat-value">@Model.TotalRevenue.ToString("0.000")</div>
            <div class="stat-trend">Paid order revenue in KD</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Platform Activity</span><span class="stat-icon amber">⚡</span></div>
            <div class="stat-value">@Model.EnrollmentsCount</div>
            <div class="stat-trend">@Model.ReviewsCount reviews · @Model.CertificatesCount certificates</div>
        </div>
    </div>
}
else if (isTeacher)
{
    <!-- Teacher dashboard -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">My Courses</span><span class="stat-icon purple">📚</span></div>
            <div class="stat-value">@Model.MyCoursesCount</div>
            <div class="stat-trend">Created by this teacher</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Student Activity</span><span class="stat-icon green">👨‍🎓</span></div>
            <div class="stat-value">@Model.EnrollmentsCount</div>
            <div class="stat-trend">Total enrollments on platform</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Teacher Revenue</span><span class="stat-icon blue">💰</span></div>
            <div class="stat-value">@Model.MyRevenue.ToString("0.000")</div>
            <div class="stat-trend">Demo paid orders related to teacher courses</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Live Sessions</span><span class="stat-icon amber">🎥</span></div>
            <div class="stat-value">@Model.LiveSessionsCount</div>
            <div class="stat-trend">Scheduled/live/completed sessions</div>
        </div>
    </div>
}
else
{
    <!-- Student/Parent dashboard -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">My Learning</span><span class="stat-icon purple">🎓</span></div>
            <div class="stat-value">@Model.MyEnrollmentsCount</div>
            <div class="stat-trend">Active enrolled courses</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Cart</span><span class="stat-icon blue">🛒</span></div>
            <div class="stat-value">@Model.MyCartCount</div>
            <div class="stat-trend">Courses waiting for checkout</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Wishlist</span><span class="stat-icon amber">⭐</span></div>
            <div class="stat-value">@Model.MyWishlistCount</div>
            <div class="stat-trend">Saved courses</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-top"><span class="stat-label">Certificates</span><span class="stat-icon green">🏆</span></div>
            <div class="stat-value">@Model.MyCertificatesCount</div>
            <div class="stat-trend">@Model.MyUnreadNotificationsCount unread notifications</div>
        </div>
    </div>
}

<div style="display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;margin-bottom:20px;">
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Recent Courses</div>
                <div class="card-subtitle">Latest courses matching your access</div>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-secondary btn-sm">View all</a>
        </div>

        @if (!Model.RecentCourses.Any())
        {
            <div class="empty-state" style="padding:32px;">
                <div class="empty-state-icon">📚</div>
                <h3>No courses yet</h3>
                <p>Courses will appear here once they are created/published.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="box-shadow:none;border:none;">
                <table>
                    <thead>
                    <tr><th>Course</th><th>Category</th><th>Level</th><th>Price</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.RecentCourses)
                    {
                        var cls = c.Status == "Published" && c.ApprovalStatus == "Approved" ? "green" : "amber";
                        <tr>
                            <td class="td-main"><a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">@c.Title</a></td>
                            <td>@c.Category</td>
                            <td><span class="badge gray">@c.Level</span></td>
                            <td>@c.Price.ToString("0.000") KD</td>
                            <td><span class="badge @cls">@c.Status / @c.ApprovalStatus</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div style="display:flex;flex-direction:column;gap:16px;">
        <div class="card">
            <div class="card-header"><div class="card-title">Quick Actions</div></div>
            <div class="quick-links">
                <a asp-controller="Courses" asp-action="Index" class="quick-link">
                    <span class="quick-link-icon" style="background:var(--brand-light);">📚</span> Browse Courses
                </a>
                <a asp-controller="Cart" asp-action="Index" class="quick-link">
                    <span class="quick-link-icon" style="background:var(--info-bg);">🛒</span> My Cart
                </a>
                <a asp-controller="Wishlist" asp-action="Index" class="quick-link">
                    <span class="quick-link-icon" style="background:var(--warning-bg);">⭐</span> Wishlist
                </a>
                <a asp-controller="Notifications" asp-action="Index" class="quick-link">
                    <span class="quick-link-icon" style="background:var(--success-bg);">🔔</span> Notifications
                </a>
                <a asp-controller="Orders" asp-action="Index" class="quick-link">
                    <span class="quick-link-icon" style="background:var(--danger-bg);">🧾</span> Orders
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div class="card-title">Upcoming Live Sessions</div></div>
            @if (!Model.UpcomingLiveSessions.Any())
            {
                <p class="muted">No upcoming sessions.</p>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:12px;">
                    @foreach (var s in Model.UpcomingLiveSessions)
                    {
                        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:12px;">
                            <strong>@s.Title</strong>
                            <div class="td-sub">@s.CourseTitle</div>
                            <div class="td-sub">@s.StartTime.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @s.Status</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (Model.RecentEnrollments.Any() || Model.RecentOrders.Any() || Model.RecentNotifications.Any())
{
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;">
        <div class="card">
            <div class="card-header"><div class="card-title">Recent Enrollments</div></div>
            @foreach (var e in Model.RecentEnrollments)
            {
                <div style="padding:10px 0;border-bottom:1px solid var(--border);">
                    <div class="td-main">@e.CourseTitle</div>
                    <div class="td-sub">@e.EnrolledAt.ToString("dd MMM yyyy") · @e.Status</div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header"><div class="card-title">Recent Orders</div></div>
            @foreach (var o in Model.RecentOrders)
            {
                <div style="padding:10px 0;border-bottom:1px solid var(--border);">
                    <div class="td-main">Order #@o.Id · @o.Total.ToString("0.000") KD</div>
                    <div class="td-sub">@o.CreatedAt.ToString("dd MMM yyyy") · @o.Status</div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header"><div class="card-title">Notifications</div></div>
            @foreach (var n in Model.RecentNotifications)
            {
                <div style="padding:10px 0;border-bottom:1px solid var(--border);">
                    <div class="td-main">@n.Title</div>
                    <div class="td-sub">@n.Message</div>
                </div>
            }
        </div>
    </div>
}
