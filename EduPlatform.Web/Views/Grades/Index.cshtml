@model IReadOnlyList<EduPlatform.Web.ViewModels.Grades.GradeListItemVM>
@{ ViewData["Title"] = "Grades"; ViewData["PageTitle"] = "Grades & Subjects"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Grades &amp; Subjects</h1>
        <p>Browse the school's grade structure and discover courses by subject</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🏫</div>
        <h3>No grades yet</h3>
        <p>Grade levels will appear here once they have been set up.</p>
    </div>
}
else
{
    <p style="font-size:13px;color:var(--text-3);margin-bottom:16px;">@Model.Count grade level@(Model.Count != 1 ? "s" : "") · @Model.Sum(g => g.SubjectCount) subjects · @Model.Sum(g => g.CourseCount) courses</p>
    <div class="card-grid">
        @foreach (var g in Model)
        {
            <div class="grade-card">
                <div class="grade-card-header">
                    <div class="grade-icon">@g.Name.Substring(0,1).ToUpper()</div>
                    <div>
                        <div class="grade-name">@g.Name</div>
                        @if (!string.IsNullOrWhiteSpace(g.Description))
                        {
                            <div class="grade-desc">@g.Description</div>
                        }
                    </div>
                </div>
                <div style="display:flex;gap:8px;">
                    <span class="grade-chip">@g.SubjectCount subject@(g.SubjectCount != 1 ? "s" : "")</span>
                    @if (g.CourseCount > 0)
                    {
                        <span class="grade-chip" style="background:var(--success-bg);color:var(--success);">@g.CourseCount course@(g.CourseCount != 1 ? "s" : "")</span>
                    }
                </div>
                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@g.Id" style="margin-top:4px;">
                    View Subjects →
                </a>
            </div>
        }
    </div>
}
