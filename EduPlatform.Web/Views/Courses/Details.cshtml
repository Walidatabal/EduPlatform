@model EduPlatform.Web.ViewModels.Courses.CourseDetailsVM
@using EduPlatform.Domain.Constants
@{
    ViewData["Title"]     = Model.Title;
    ViewData["PageTitle"] = Model.Title;
    bool canEdit = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Teacher);
}

<!-- Hero -->
<div class="detail-hero" style="@(!string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? $"background-image:url('{Model.ThumbnailUrl}');background-size:cover;background-position:center;" : "")">
    <div style="background:rgba(30,27,75,.72);border-radius:var(--radius-xl);padding:36px 40px;">
        @if (Model.CategoryName != null)
        {
            <div class="detail-hero-category">@Model.CategoryName</div>
        }
        <h1>@Model.Title</h1>

        <div class="detail-hero-meta">
            <span><i class="bi bi-bar-chart-fill"></i> @Model.Level</span>
            <span><i class="bi bi-globe2"></i> @Model.Language</span>
            @if (Model.GradeName != null)
            {
                <span><i class="bi bi-mortarboard-fill"></i> @Model.GradeName — @Model.SubjectName</span>
            }
            <span><i class="bi bi-people-fill"></i> @Model.EnrollmentCount enrolled</span>
            @if (Model.ReviewCount > 0)
            {
                <span><i class="bi bi-star-fill" style="color:#F59E0B;"></i> @Model.AverageRating.ToString("0.0") (@Model.ReviewCount reviews)</span>
            }
        </div>

        <div class="detail-hero-actions">
            @if (Model.IsEnrolled)
            {
                <span class="btn btn-white"><i class="bi bi-check-circle-fill"></i> Enrolled</span>
            }
            else if (Model.Price == 0)
            {
                <form asp-controller="Enrollments" asp-action="Enroll" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <button type="submit" class="btn btn-white"><i class="bi bi-lightning-fill"></i> Enroll Free</button>
                </form>
            }
            else
            {
                <form asp-controller="Cart" asp-action="Add" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <button type="submit" class="btn btn-white">
                        <i class="bi bi-cart-plus-fill"></i> Add to Cart — @Model.Price.ToString("0.##") KD
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-white"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>
</div>

<!-- TempData alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">⚠ @TempData["Error"]</div>
}

<!-- Thumbnail upload panel (teachers/admins only) -->
@if (canEdit)
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
            <span class="card-title"><i class="bi bi-image"></i> Course Thumbnail</span>
        </div>

        <div style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;">

            <!-- Preview -->
            <div style="width:180px;height:110px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);flex-shrink:0;background:var(--surface-2);display:flex;align-items:center;justify-content:center;">
                @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                {
                    <img id="thumb-preview" src="@Model.ThumbnailUrl" alt="thumbnail"
                         style="width:100%;height:100%;object-fit:cover;" />
                }
                else
                {
                    <img id="thumb-preview" src="" alt="preview"
                         style="width:100%;height:100%;object-fit:cover;display:none;" />
                    <i class="bi bi-image" id="thumb-placeholder"
                       style="font-size:36px;color:var(--text-4);"></i>
                }
            </div>

            <!-- Upload form -->
            <div style="flex:1;min-width:220px;">
                <form asp-action="UploadThumbnail" asp-route-id="@Model.Id"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <label class="upload-drop-zone" for="thumbnail-input" id="drop-zone">
                        <i class="bi bi-cloud-upload" style="font-size:24px;color:var(--brand);"></i>
                        <span style="font-size:13px;color:var(--text-2);margin-top:6px;">
                            Drag & drop or <strong>click to choose</strong>
                        </span>
                        <span style="font-size:11px;color:var(--text-4);">JPEG, PNG, WebP — max 5 MB</span>
                        <input id="thumbnail-input" name="thumbnail" type="file"
                               accept="image/jpeg,image/png,image/webp,image/gif"
                               style="display:none;" />
                    </label>

                    <div style="display:flex;gap:10px;margin-top:10px;">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                        {
                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="document.getElementById('remove-form').submit()">
                                <i class="bi bi-trash"></i> Remove
                            </button>
                        }
                    </div>
                </form>

                <form id="remove-form"
                      asp-action="RemoveThumbnail" asp-route-id="@Model.Id"
                      method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
}

<!-- Main content grid -->
<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">

    <div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><span class="card-title">About this course</span></div>
                <p style="font-size:14px;color:var(--text-2);line-height:1.7;">@Model.Description</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LearningOutcomes))
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><span class="card-title"><i class="bi bi-check2-square"></i> What you'll learn</span></div>
                <p style="font-size:14px;color:var(--text-2);line-height:1.7;white-space:pre-line;">@Model.LearningOutcomes</p>
            </div>
        }

        @if (Model.Sections.Any())
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><span class="card-title"><i class="bi bi-collection-play"></i> Course Content</span></div>
                <div class="section-tree">
                    @foreach (var courseSection in Model.Sections)
                    {
                        <div class="section-item">
                            <div class="section-header">
                                <div class="section-header-left">
                                    <span class="section-num">@courseSection.Order</span>
                                    <span>@courseSection.Title</span>
                                </div>
                                <span style="font-size:12px;color:var(--text-4);">@courseSection.Lessons.Count lessons</span>
                            </div>
                            <div class="lesson-list">
                                @foreach (var lesson in courseSection.Lessons)
                                {
                                    <div class="lesson-item">
                                        <div class="lesson-icon">
                                            @if (lesson.ContentType == "Video") { <i class="bi bi-play-circle"></i> }
                                            else if (lesson.ContentType == "Quiz") { <i class="bi bi-question-circle"></i> }
                                            else { <i class="bi bi-file-text"></i> }
                                        </div>
                                        <span>@lesson.Title</span>
                                        <span class="lesson-type-badge">@lesson.ContentType</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.Reviews.Any())
        {
            <div class="card">
                <div class="card-header"><span class="card-title"><i class="bi bi-chat-quote"></i> Reviews</span></div>
                <div class="activity-feed">
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="activity-item">
                            <div class="avatar sm">S</div>
                            <div class="activity-content">
                                <strong>@r.StudentName</strong>
                                <div class="stars">@(new string('★', r.Rating))</div>
                                @if (!string.IsNullOrWhiteSpace(r.Comment))
                                {
                                    <p>@r.Comment</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div>
        @if (!string.IsNullOrWhiteSpace(Model.Requirements))
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><span class="card-title"><i class="bi bi-clipboard-check"></i> Requirements</span></div>
                <p style="font-size:14px;color:var(--text-2);white-space:pre-line;">@Model.Requirements</p>
            </div>
        }

        <div class="card">
            <div class="card-header"><span class="card-title">Course Info</span></div>
            <table style="width:100%;font-size:13px;border-collapse:collapse;">
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:8px 0;color:var(--text-3);">Level</td>
                    <td style="padding:8px 0;font-weight:600;">@Model.Level</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:8px 0;color:var(--text-3);">Language</td>
                    <td style="padding:8px 0;font-weight:600;">@Model.Language</td>
                </tr>
                @if (Model.SubjectName != null)
                {
                    <tr style="border-bottom:1px solid var(--border);">
                        <td style="padding:8px 0;color:var(--text-3);">Subject</td>
                        <td style="padding:8px 0;font-weight:600;">@Model.SubjectName</td>
                    </tr>
                }
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:8px 0;color:var(--text-3);">Students</td>
                    <td style="padding:8px 0;font-weight:600;">@Model.EnrollmentCount</td>
                </tr>
                <tr>
                    <td style="padding:8px 0;color:var(--text-3);">Price</td>
                    <td style="padding:8px 0;font-weight:600;color:@(Model.Price == 0 ? "var(--success)" : "var(--text-1)");">
                        @(Model.Price == 0 ? "Free" : $"{Model.Price:0.##} KD")
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<style>
.upload-drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    padding: 20px;
    cursor: pointer;
    transition: border-color .2s, background .2s;
    text-align: center;
}
.upload-drop-zone:hover,
.upload-drop-zone.drag-over {
    border-color: var(--brand);
    background: var(--brand-light);
}
</style>
<script>
(function () {
    const input     = document.getElementById('thumbnail-input');
    const preview   = document.getElementById('thumb-preview');
    const placeholder = document.getElementById('thumb-placeholder');
    const dropZone  = document.getElementById('drop-zone');

    function showPreview(file) {
        const reader = new FileReader();
        reader.onload = e => {
            if (preview)   { preview.src = e.target.result; preview.style.display = 'block'; }
            if (placeholder) placeholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
    }

    input?.addEventListener('change', () => {
        if (input.files?.[0]) showPreview(input.files[0]);
    });

    dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone?.addEventListener('dragleave', ()  => dropZone.classList.remove('drag-over'));
    dropZone?.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = e.dataTransfer?.files?.[0];
        if (file && input) {
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            showPreview(file);
        }
    });
})();
</script>
}
