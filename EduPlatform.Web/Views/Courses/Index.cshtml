@model IReadOnlyList<EduPlatform.Web.ViewModels.Courses.CourseListItemVM>
@{ ViewData["Title"] = "Courses"; ViewData["PageTitle"] = "Browse Courses"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Courses</h1>
        <p>Discover published courses across all grade levels and subjects</p>
    </div>
</div>

<!-- Search + filter -->
<form method="get" asp-action="Index" style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;">
    <div class="search-bar">
        <i class="bi bi-search" style="color:var(--text-4);flex-shrink:0;"></i>
        <input name="search" value="@ViewBag.Search" placeholder="Search courses…" />
    </div>
    <div class="filter-bar" style="margin:0;">
        <button type="submit" name="level" value="" class="filter-chip @(ViewBag.Level == null ? "active" : "")">All levels</button>
        <button type="submit" name="level" value="Beginner" class="filter-chip @(ViewBag.Level == "Beginner" ? "active" : "")">Beginner</button>
        <button type="submit" name="level" value="Intermediate" class="filter-chip @(ViewBag.Level == "Intermediate" ? "active" : "")">Intermediate</button>
        <button type="submit" name="level" value="Advanced" class="filter-chip @(ViewBag.Level == "Advanced" ? "active" : "")">Advanced</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-book"></i></div>
        <h3>No courses found</h3>
        <p>@(ViewBag.Search != null ? "Try a different search term or clear the filter." : "No published courses are available yet.")</p>
        @if (ViewBag.Search != null)
        {
            <a asp-action="Index" class="btn btn-secondary">Clear filter</a>
        }
    </div>
}
else
{
    <p style="font-size:13px;color:var(--text-3);margin-bottom:16px;">
        Showing <strong>@Model.Count</strong> course@(Model.Count != 1 ? "s" : "")
    </p>

    <div class="card-grid">
        @foreach (var c in Model)
        {
            <a asp-action="Details" asp-route-id="@c.Id" class="course-card" style="text-decoration:none;color:inherit;">

                <!-- Thumbnail -->
                <div class="course-thumb">
                    @if (!string.IsNullOrWhiteSpace(c.ThumbnailUrl))
                    {
                        <img src="@c.ThumbnailUrl"
                             alt="@c.Title thumbnail"
                             style="width:100%;height:100%;object-fit:cover;display:block;" />
                    }
                    else
                    {
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--brand-light),#E0E7FF);">
                            <i class="bi bi-book-fill" style="font-size:40px;color:var(--brand);opacity:.6;"></i>
                        </div>
                    }
                    <span class="course-thumb-badge">@c.Level</span>
                </div>

                <!-- Body -->
                <div class="course-body">
                    @if (c.CategoryName != null)
                    {
                        <div class="course-category">@c.CategoryName</div>
                    }
                    <div class="course-title">@c.Title</div>
                    @if (c.Description != null)
                    {
                        <div class="course-desc">@c.Description</div>
                    }
                    <div class="course-meta">
                        <span><i class="bi bi-globe2"></i> @c.Language</span>
                        @if (c.GradeName != null)
                        {
                            <span><i class="bi bi-mortarboard"></i> @c.GradeName</span>
                        }
                        <span><i class="bi bi-people"></i> @c.EnrollmentCount</span>
                    </div>

                    @if (c.ReviewCount > 0)
                    {
                        <div style="display:flex;align-items:center;gap:4px;font-size:12px;">
                            <span class="stars">@(new string('★', (int)Math.Round(c.AverageRating)))</span>
                            <span style="color:var(--text-3);">@c.AverageRating.ToString("0.0") (@c.ReviewCount)</span>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="course-footer">
                    <span class="course-price @(c.Price == 0 ? "free" : "")">
                        @(c.Price == 0 ? "Free" : $"{c.Price:0.##} KD")
                    </span>
                    <span class="btn btn-primary btn-sm">View Course</span>
                </div>

            </a>
        }
    </div>
}
