@model ProfileVM
@{
    ViewData["Title"] = "Profile";
    ViewData["PageTitle"] = "My Profile";

    var lang = Context.Request.Query["lang"].ToString();
    if (string.IsNullOrWhiteSpace(lang))
        lang = Context.Request.Cookies["lang"] ?? "en";
    var isArabic = lang == "ar";

    string initials = (Model.FullName ?? "U").Length > 0
        ? (Model.FullName ?? "U").Substring(0, 1).ToUpper()
        : "U";
}

<!-- TempData alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;">⚠ @TempData["Error"]</div>
}

<section class="page-header">
    <div>
        <h1>@(isArabic ? "الملف الشخصي" : "My Profile")</h1>
        <p class="muted">@(isArabic ? "إدارة بيانات حسابك الأساسية." : "Manage your basic account information.")</p>
    </div>
</section>

<!-- Avatar card -->
<div class="card form-card" style="margin-bottom:20px;">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-person-circle"></i> @(isArabic ? "صورة الملف الشخصي" : "Profile Picture")</span>
    </div>

    <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;">

        <!-- Avatar preview -->
        <div style="position:relative;flex-shrink:0;">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img id="avatar-preview" src="@Model.AvatarUrl" alt="avatar"
                     style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--border);" />
            }
            else
            {
                <div id="avatar-fallback"
                     style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand-mid));color:white;font-weight:700;font-size:28px;display:flex;align-items:center;justify-content:center;">
                    @initials
                </div>
                <img id="avatar-preview" src="" alt="preview"
                     style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--border);display:none;" />
            }
        </div>

        <!-- Upload form -->
        <div style="flex:1;min-width:200px;">
            <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <label class="upload-drop-zone" for="avatar-input" id="avatar-drop-zone">
                    <i class="bi bi-cloud-upload" style="font-size:20px;color:var(--brand);"></i>
                    <span style="font-size:13px;color:var(--text-2);">
                        @(isArabic ? "اسحب أو اضغط لاختيار صورة" : "Drag & drop or click to choose")
                    </span>
                    <span style="font-size:11px;color:var(--text-4);">JPEG, PNG, WebP — max 5 MB</span>
                    <input id="avatar-input" name="avatar" type="file"
                           accept="image/jpeg,image/png,image/webp"
                           style="display:none;" />
                </label>

                <div style="display:flex;gap:8px;margin-top:10px;">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-upload"></i>
                        @(isArabic ? "رفع الصورة" : "Upload")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <button type="button" class="btn btn-danger btn-sm"
                                onclick="document.getElementById('remove-avatar-form').submit()">
                            <i class="bi bi-trash"></i>
                            @(isArabic ? "حذف" : "Remove")
                        </button>
                    }
                </div>
            </form>

            <form id="remove-avatar-form" asp-action="RemoveAvatar" method="post" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>

<!-- Profile edit form -->
<div class="card form-card">
    <form asp-controller="Account" asp-action="Profile" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FullName">@(isArabic ? "الاسم الكامل" : "Full Name")</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">@(isArabic ? "البريد الإلكتروني" : "Email Address")</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">@(isArabic ? "رقم الهاتف" : "Phone Number")</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                @(isArabic ? "حفظ التغييرات" : "Save Changes")
            </button>
            <a asp-action="ChangePassword" class="btn btn-secondary">
                <i class="bi bi-lock"></i>
                @(isArabic ? "تغيير كلمة المرور" : "Change Password")
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        .upload-drop-zone {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            border: 2px dashed var(--border);
            border-radius: var(--radius);
            padding: 16px;
            cursor: pointer;
            transition: border-color .2s, background .2s;
            text-align: center;
        }

            .upload-drop-zone:hover,
            .upload-drop-zone.drag-over {
                border-color: var(--brand);
                background: var(--brand-light);
            }
    </style>
    <script>
        (function () {
            const input     = document.getElementById('avatar-input');
            const preview   = document.getElementById('avatar-preview');
            const fallback  = document.getElementById('avatar-fallback');
            const dropZone  = document.getElementById('avatar-drop-zone');

            function showPreview(file) {
                const reader = new FileReader();
                reader.onload = e => {
                    if (preview)  { preview.src = e.target.result; preview.style.display = 'block'; }
                    if (fallback) fallback.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }

            input?.addEventListener('change', () => {
                if (input.files?.[0]) showPreview(input.files[0]);
            });

            dropZone?.addEventListener('dragover',  e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
            dropZone?.addEventListener('dragleave', ()  => dropZone.classList.remove('drag-over'));
            dropZone?.addEventListener('drop', e => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                const file = e.dataTransfer?.files?.[0];
                if (file && input) {
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    input.files = dt.files;
                    showPreview(file);
                }
            });
        })();
    </script>
}
