@model ProfileVM

@{
    ViewData["Title"] = "Profile";
    ViewData["PageTitle"] = "My Profile";

    var lang = Context.Request.Query["lang"].ToString();
    if (string.IsNullOrWhiteSpace(lang))
    {
        lang = Context.Request.Cookies["lang"] ?? "en";
    }

    var isArabic = lang == "ar";
}

<section class="page-header">
    <div>
        <h1>@(isArabic ? "الملف الشخصي" : "My Profile")</h1>
        <p class="muted">
            @(isArabic ? "إدارة بيانات حسابك الأساسية." : "Manage your basic account information.")
        </p>
    </div>
</section>

@* Profile edit form: only profile fields are inside this POST form. *@
<div class="card form-card">
    <form asp-controller="Account" asp-action="Profile" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FullName">@(isArabic ? "الاسم الكامل" : "Full Name")</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">@(isArabic ? "البريد الإلكتروني" : "Email Address")</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">@(isArabic ? "رقم الهاتف" : "Phone Number")</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label>@(isArabic ? "الأدوار" : "Roles")</label>
                <div class="role-list">
                    @if (Model.Roles != null && Model.Roles.Any())
                    {
                        foreach (var role in Model.Roles)
                        {
                            var cls = role switch
                            {
                                "Admin" => "badge badge-role badge-admin",
                                "ContentManager" => "badge badge-role badge-manager",
                                "Teacher" => "badge badge-role badge-teacher",
                                "PendingTeacher" => "badge badge-role badge-pending",
                                "Parent" => "badge badge-role badge-parent",
                                "Student" => "badge badge-role badge-student",
                                _ => "badge badge-role"
                            };

                            var lbl = isArabic ? role switch
                            {
                                "Admin" => "مدير النظام",
                                "ContentManager" => "مدير المحتوى",
                                "Teacher" => "معلم",
                                "PendingTeacher" => "معلم قيد المراجعة",
                                "Parent" => "ولي أمر",
                                "Student" => "طالب",
                                _ => role
                            } : role;

                            <span class="@cls">@lbl</span>
                        }
                    }
                    else
                    {
                        <span class="muted">@(isArabic ? "لا توجد أدوار مسجلة." : "No roles assigned.")</span>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i>
                @(isArabic ? "حفظ التغييرات" : "Save Changes")
            </button>

            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i>
                @(isArabic ? "رجوع" : "Back")
            </a>
        </div>
    </form>
</div>

@* Security actions are intentionally outside the profile POST form to avoid accidental profile submission. *@
<div class="card form-card profile-security-wrapper">
    <div class="profile-security-card">
        <div class="profile-security-text">
            <div class="profile-security-title">
                <i class="bi bi-shield-lock-fill"></i>
                @(isArabic ? "تغيير كلمة المرور" : "Change Password")
            </div>
            <div class="profile-security-subtitle">
                @(isArabic
                    ? "قم بتحديث كلمة مرورك بشكل دوري للحفاظ على أمان حسابك."
                    : "Update your password regularly to keep your account secure.")
            </div>
        </div>

        @* GET form guarantees navigation to /Account/ChangePassword and avoids nested-form problems. *@
        <form asp-controller="Account" asp-action="ChangePassword" method="get" class="m-0">
            <button type="submit" class="btn btn-secondary">
                <i class="bi bi-shield-lock"></i>
                @(isArabic ? "تغيير كلمة المرور" : "Change Password")
            </button>
        </form>
    </div>
</div>

<style>
    .profile-security-wrapper {
        margin-top: 16px;
    }

    .profile-security-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .profile-security-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .profile-security-title i {
        color: #4f46e5;
    }

    .profile-security-subtitle {
        font-size: 13px;
        color: #64748b;
        margin-top: 4px;
    }

    @@media (max-width: 768px) {
        .profile-security-card {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
