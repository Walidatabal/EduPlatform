@model ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    ViewData["PageTitle"] = "Reset User Password";

    var currentLang = Context.Request.Query["lang"].ToString();

    if (string.IsNullOrWhiteSpace(currentLang))
    {
        currentLang = Context.Request.Cookies["lang"] ?? "en";
    }

    var isArabic = currentLang == "ar";
}

<section class="page-header">
    <div>
        <h1>@(isArabic ? "إعادة تعيين كلمة المرور" : "Reset User Password")</h1>
        <p class="muted">@Model.UserDisplayName</p>
    </div>
</section>

<div class="card form-card">
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="UserId" type="hidden" />
        <input asp-for="UserDisplayName" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid single">
            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
        </div>

        <div class="alert warning">
            @(isArabic ? "تنبيه: سيتم تغيير كلمة مرور المستخدم وفك قفل الحساب إن كان مقفولاً." : "Warning: this will change the user's password and unlock the account if locked.")
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-key-fill"></i>
                @(isArabic ? "إعادة التعيين" : "Reset Password")
            </button>

            <a asp-action="Users" class="btn btn-secondary">
                @(isArabic ? "إلغاء" : "Cancel")
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
