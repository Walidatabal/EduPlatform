@model ChangePasswordVM

@{
    ViewData["Title"] = "Change Password";
    ViewData["PageTitle"] = "Change Password";

    var currentLang = Context.Request.Query["lang"].ToString();

    if (string.IsNullOrWhiteSpace(currentLang))
    {
        currentLang = Context.Request.Cookies["lang"] ?? "en";
    }

    var isArabic = currentLang == "ar";
}

<section class="page-header">
    <div>
        <h1>@(isArabic ? "تغيير كلمة المرور" : "Change Password")</h1>
        <p class="muted">
            @(isArabic ? "استخدم كلمة مرور قوية لحماية حسابك." : "Use a strong password to protect your account.")
        </p>
    </div>
</section>

<div class="card form-card">
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid single">
            <div class="form-group">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-shield-check"></i>
                @(isArabic ? "تحديث كلمة المرور" : "Update Password")
            </button>

            <a asp-controller="Account"
               asp-action="Profile"
               class="btn btn-secondary">
                @(isArabic ? "إلغاء" : "Cancel")
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
