@using EduPlatform.Domain.Constants
@{
    var currentLang = Context.Request.Query["lang"].ToString();

    if (string.IsNullOrWhiteSpace(currentLang))
    {
        currentLang = Context.Request.Cookies["lang"] ?? "en";
    }

    var isArabic = currentLang == "ar";
}

<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduPlatform</title>

    <!-- Bootstrap Icons must load BEFORE site.css so our icon fixes apply correctly -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%234F46E5'/><text x='8' y='24' font-size='20' fill='white' font-weight='bold'>E</text></svg>" />
</head>

<body class="@(isArabic ? "rtl-layout" : "")">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">

            <aside class="sidebar enterprise-sidebar">

                <div class="sidebar-logo">
                    <div class="sidebar-logo-icon logo-box">E</div>

                    <div class="sidebar-logo-text logo-text">
                        <h4>EduPlatform</h4>
                        <small>Enterprise LMS</small>
                    </div>
                </div>

                <div class="sidebar-scroll">

                    <div class="sidebar-section">
                        <p class="sidebar-section-label sidebar-title">
                            @(isArabic ? "الرئيسية" : "MAIN")
                        </p>

                        <nav class="sidebar-nav">

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>@(isArabic ? "لوحة التحكم" : "Dashboard")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")"
                               asp-controller="Courses"
                               asp-action="Index">
                                <i class="bi bi-book-fill"></i>
                                <span>@(isArabic ? "الكورسات" : "Courses")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grades" ? "active" : "")"
                               asp-controller="Grades"
                               asp-action="Index">
                                <i class="bi bi-mortarboard-fill"></i>
                                <span>@(isArabic ? "المراحل والمواد" : "Grades & Subjects")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Enrollments" ? "active" : "")"
                               asp-controller="Enrollments"
                               asp-action="Index">
                                <i class="bi bi-journal-check"></i>
                                <span>@(isArabic ? "تعلمي" : "My Learning")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "active" : "")"
                               asp-controller="Cart"
                               asp-action="Index">
                                <i class="bi bi-cart-fill"></i>
                                <span>@(isArabic ? "السلة" : "Cart")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wishlist" ? "active" : "")"
                               asp-controller="Wishlist"
                               asp-action="Index">
                                <i class="bi bi-heart-fill"></i>
                                <span>@(isArabic ? "المفضلة" : "Wishlist")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"
                               asp-controller="Orders"
                               asp-action="Index">
                                <i class="bi bi-receipt"></i>
                                <span>@(isArabic ? "الطلبات" : "Orders")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Certificates" ? "active" : "")"
                               asp-controller="Certificates"
                               asp-action="Index">
                                <i class="bi bi-award-fill"></i>
                                <span>@(isArabic ? "الشهادات" : "Certificates")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LiveSessions" ? "active" : "")"
                               asp-controller="LiveSessions"
                               asp-action="Index">
                                <i class="bi bi-camera-video-fill"></i>
                                <span>@(isArabic ? "الجلسات المباشرة" : "Live Sessions")</span>
                            </a>

                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")"
                               asp-controller="Notifications"
                               asp-action="Index">
                                <i class="bi bi-bell-fill"></i>
                                <span>@(isArabic ? "الإشعارات" : "Notifications")</span>
                            </a>


                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.ContentManager))
                            {
                                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                                   asp-controller="Account"
                                   asp-action="Users">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>@(isArabic ? "التحكم بالصلاحيات" : "Access Control")</span>
                                </a>

                                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PendingTasks" ? "active" : "")"
                                   asp-controller="PendingTasks"
                                   asp-action="Index">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>@(isArabic ? "المهام المعلقة" : "Pending Tasks")</span>
                                </a>
                            }

                        </nav>
                    </div>

                    <div class="sidebar-section">
                        <p class="sidebar-section-label sidebar-title">
                            @(isArabic ? "الحساب" : "ACCOUNT")
                        </p>

                        <nav class="sidebar-nav">

                            <a class="sidebar-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                <span>@(isArabic ? "الرئيسية العامة" : "Public Home")</span>
                            </a>

                            <a class="sidebar-link"
                               asp-controller="Account"
                               asp-action="Profile">
                                <i class="bi bi-person-circle"></i>
                                <span>@(isArabic ? "الملف الشخصي" : "Profile")</span>
                            </a>

                            <a class="sidebar-link"
                               asp-controller="Language"
                               asp-action="Set"
                               asp-route-culture="@(isArabic ? "en" : "ar")">
                                <i class="bi bi-translate"></i>
                                <span>@(isArabic ? "English" : "العربية")</span>
                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="sidebar-link sidebar-logout-button text-danger">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>@(isArabic ? "تسجيل الخروج" : "Logout")</span>
                                </button>
                            </form>

                        </nav>
                    </div>

                </div>

                <div class="sidebar-user">
                    <div class="avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>

                    <div class="sidebar-user-info">
                        <strong>@User.Identity?.Name</strong>
                        <span>@(isArabic ? "تم تسجيل الدخول" : "Signed in")</span>
                    </div>
                </div>

            </aside>

            <div class="main-content">

                <header class="topbar">
                    <div class="topbar-title">
                        @(ViewData["PageTitle"] ?? ViewData["Title"])
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            ✓ @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            ⚠ @TempData["Error"]
                        </div>
                    }
                </header>

                <main class="page">
                    @RenderBody()
                </main>

            </div>

        </div>
    }
    else
    {
        <div class="public-shell">

            <nav class="public-nav">
                <a class="public-nav-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="public-nav-logo-icon">E</span>
                    EduPlatform
                </a>

                <div class="public-nav-links">
                    <a asp-controller="Courses" asp-action="Index">
                        @(isArabic ? "الكورسات" : "Courses")
                    </a>

                    <a asp-controller="Grades" asp-action="Index">
                        @(isArabic ? "المراحل" : "Grades")
                    </a>
                </div>

                <div class="public-nav-actions">
                    <a class="btn btn-secondary btn-sm"
                       asp-controller="Language"
                       asp-action="Set"
                       asp-route-culture="@(isArabic ? "en" : "ar")">
                        @(isArabic ? "English" : "العربية")
                    </a>

                    <a class="btn btn-secondary btn-sm"
                       asp-controller="Account"
                       asp-action="Login">
                        @(isArabic ? "تسجيل الدخول" : "Sign In")
                    </a>

                    <a class="btn btn-primary btn-sm"
                       asp-controller="Account"
                       asp-action="Register">
                        @(isArabic ? "ابدأ الآن" : "Get Started")
                    </a>
                </div>
            </nav>

            <main>
                @RenderBody()
            </main>

            <footer class="public-footer">
                <span>© 2026 EduPlatform — Enterprise School LMS</span>

                <div class="footer-links">
                    <a asp-controller="Courses" asp-action="Index">
                        @(isArabic ? "الكورسات" : "Courses")
                    </a>

                    <a asp-controller="Grades" asp-action="Index">
                        @(isArabic ? "المراحل" : "Grades")
                    </a>

                    <a asp-controller="Account" asp-action="Login">
                        @(isArabic ? "تسجيل الدخول" : "Login")
                    </a>
                </div>
            </footer>

        </div>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>