<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduPlatform Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">EduPlatform</a>
        <nav>
            <a asp-controller="Grades" asp-action="Index">Grades</a>
            <a asp-controller="Courses" asp-action="Index">Courses</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
            }
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <span>EduPlatform Enterprise School LMS</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
