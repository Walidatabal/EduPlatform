# Copy this file to .env and fill in your values before running Docker Compose.
# Docker Compose reads .env automatically from the project root.

# SQL Server SA password — must match what was used when the volume was first created.
# If you change this after the volume exists, run: docker compose down -v
MSSQL_SA_PASSWORD=Dev_Password123!

# Admin seeding credentials — used by the API to create/reset the admin account on startup.
ADMIN_EMAIL=admin@eduplatform.com
ADMIN_PASSWORD=Admin@123456

# JWT signing key — MUST be at least 32 characters. Change this in production.
JWT_KEY=docker-dev-secret-key-change-in-production-32chars
