# EduPlatform Environment Variables Template
# Copy this file to .env for local Docker only.
# NEVER commit .env to GitHub.

# -----------------------------
# Docker SQL Server
# -----------------------------
MSSQL_SA_PASSWORD=ChangeThis_StrongSqlPassword_2026!

# -----------------------------
# JWT Authentication
# Must be long, private, and at least 32 characters.
# Changing this invalidates existing JWT/refresh-token sessions.
# -----------------------------
JWT_KEY=EduPlatform_Docker_Development_JWT_SECRET_KEY_2026_ChangeThis_123456789

# -----------------------------
# Admin seed account
# -----------------------------
ADMIN_EMAIL=admin@eduplatform.com
ADMIN_PASSWORD=ChangeThis_AdminPassword_2026!

# -----------------------------
# Production / Azure examples
# Use these in Azure App Service Environment Variables, not in GitHub.
# -----------------------------
# ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=EduPlatformDb;User ID=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
# ASPNETCORE_ENVIRONMENT=Production
# Cors__AllowedOrigins__0=https://your-web-app.azurewebsites.net

# -----------------------------
# Email provider examples
# -----------------------------
# EmailSettings__Host=smtp.gmail.com
# EmailSettings__Port=587
# EmailSettings__Username=your-email@example.com
# EmailSettings__Password=your-app-password
# EmailSettings__From=noreply@eduplatform.com

# -----------------------------
# Azure Blob Storage examples
# -----------------------------
# BlobStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# BlobStorage__ContainerName=eduplatform-files

# -----------------------------
# Payment provider examples
# -----------------------------
# Payment__Provider=MyFatoorah
# MyFatoorah__ApiKey=your-secret-api-key
# MyFatoorah__BaseUrl=https://apitest.myfatoorah.com
